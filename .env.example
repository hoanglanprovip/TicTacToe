# ==== Cau hinh chay server (doc tu dong khi 
pm start) ====
# KHONG commit file nay len Git.

# Cong web + API
PORT=4000

# File du lieu (KHONG doi): chua tai khoan, phong, va NAO BOT da train.
# Dung duong dan TUYET DOI de luon giu du lieu o mot cho, ke ca khi chay tu thu muc khac.
DB_PATH=duong-dan-tuong-doi-toi-thu-muc-du-lieu,-vi-du:/var/lib/tictactoe/game.json

# Bat buoc khi chay that (sinh ngau nhien 64 ky tu)
JWT_SECRET=<sinh-ngau-nhien-64-ky-tu>

# Mat khau tai khoan admin tao lan dau. DOI NGAY trong trang Ho so!
ADMIN_PASSWORD=123

# KHONG dat NODE_ENV=production khi mo bang IP thuong (can HTTPS),
# neu dat thi cookie se yeu cau HTTPS va ban se khong dang nhap duoc.
